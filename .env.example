NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://taufik@localhost:5432/postgres
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_TTL_SECONDS=300
SESSION_TTL_SECONDS=43200
CLOUDINARY_URL=
# Alternatively, use all three variables below instead of CLOUDINARY_URL.
CLOUDINARY_URL=
# Optional: protect GET /api/v1/public/reservations/expire-due for an external scheduler.
CRON_SECRET=

# Set all four together when enabling Xendit website checkout. Use https://api.xendit.co for Xendit API. Do not commit actual credentials.
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
WEBSITE_BASE_URL=
