            },
            {
              "name": "Create Phone",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/v1/admin/reservations",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"source\": \"phone\",\n  \"guest\": {\n    \"fullName\": \"Nabila Putri\",\n    \"phone\": \"+6285711223344\",\n    \"email\": \"nabila@example.com\"\n  },\n  \"checkInDate\": \"2026-10-10\",\n  \"checkOutDate\": \"2026-10-12\",\n  \"rooms\": [\n    {\n      \"roomTypeId\": \"{{roomTypeId}}\",\n      \"adults\": 2,\n      \"children\": 0\n    }\n  ],\n  \"confirm\": false\n}",
                  "options": {
