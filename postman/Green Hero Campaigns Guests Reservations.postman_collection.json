                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "  const body = pm.response.json();",
                      "  const id = body.reservation?.id;",
                      "  if (id) pm.collectionVariables.set('reservationId', id);",
                      "}"
                    ]
                  }
                }
